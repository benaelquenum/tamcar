{
  "appId": "com.tamcar.client",
  "appName": "TamCar",
  "webDir": "www",
  "server": {
    "url": "https://tamcar-client.vercel.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_tamcar",
      "iconColor": "#2563EB"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
